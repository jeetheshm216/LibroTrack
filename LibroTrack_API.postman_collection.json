              "raw": "{\n  \"title\": \"\",\n  \"author\": \"\",\n  \"isbn\": \"\",\n  \"category\": \"\",\n  \"totalCopies\": -5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
