{
  "info": {
    "_postman_id": "c928424a-7182-4217-bfd2-0947701bc24d",
    "name": "LibroTrack API",
    "description": "Postman Collection for the LibroTrack College Library Management System.\nBase URL is set to `http://localhost:8080` by default.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Add Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Architecture: A Craftsman's Guide to Software Structure and Design\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"978-0134494166\",\n  \"category\": \"Software Engineering\",\n  \"totalCopies\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            },
            "description": "Registers a new book in the catalog. Sets availableCopies equal to totalCopies."
          }
        },
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            },
            "description": "Retrieves the full list of books in the library."
          }
        },
        {
          "name": "Get Book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "1"]
            },
            "description": "Retrieves a single book by its primary key ID."
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Architecture (Updated Edition)\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"978-0134494166\",\n  \"category\": \"Software Engineering\",\n  \"totalCopies\": 6\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "1"]
            },
            "description": "Updates book details and adjusts available copies accordingly."
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "1"]
            },
            "description": "Deletes a book if no copies are currently issued."
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/search?query=computer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "computer"
                }
              ]
            },
            "description": "Performs case-insensitive search matching title, author, or category."
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Add Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Aditya\",\n  \"registerNumber\": \"2024CS105\",\n  \"email\": \"vikram.aditya@college.edu\",\n  \"department\": \"Computer Science\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Registers a new student."
          }
        },
        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Retrieves all registered students along with their active borrowed book count."
          }
        },
        {
          "name": "Get Student",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "1"]
            },
            "description": "Retrieves student details by ID."
          }
        },
        {
          "name": "Get Student Issued Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/1/issued-books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "1", "issued-books"]
            },
            "description": "Retrieves the currently issued (active) books for a given student."
          }
        }
      ]
    },
    {
      "name": "Issues",
      "item": [
        {
          "name": "Issue Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1,\n  \"studentId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/issues",
              "host": ["{{baseUrl}}"],
              "path": ["api", "issues"]
            },
            "description": "Issues a book to a student. Automatically calculates 14-day due date and decrements availableCopies."
          }
        },
        {
          "name": "Get All Issues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/issues",
              "host": ["{{baseUrl}}"],
              "path": ["api", "issues"]
            },
            "description": "Retrieves all issuance records (both active and returned)."
          }
        },
        {
          "name": "Get Active Issues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/issues/active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "issues", "active"]
            },
            "description": "Retrieves all currently active borrowings (status = ISSUED)."
          }
        },
        {
          "name": "Return Book",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/issues/1/return",
              "host": ["{{baseUrl}}"],
              "path": ["api", "issues", "1", "return"]
            },
            "description": "Processes return of an issued book, marks status RETURNED, increments availableCopies, and calculates ₹5/day overdue fine."
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "stats"]
            },
            "description": "Retrieves computed dashboard statistics: totalBooks, totalStudents, totalCopies, availableCopies, issuedBooks, overdueBooks, totalFines."
          }
        }
      ]
    },
